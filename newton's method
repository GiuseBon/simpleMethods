import math

#Newtons Method, please put original function in f1 and derivative in f2
L = 10
M = 4
def f1(x): #f(x)
    return 2*x*math.sinh(M/x) - L

def f2(x): # derivative of f(x), f'(x)
    return 2*math.sinh(M/x) - 2*math.cosh(M/x)*(M/x)

epsilon = 0.0001
xn = 5
count = 0
t = True
while t == True and count < 10000:
    prev = xn
    xn = xn - f1(xn)/f2(xn)
    if abs(prev - xn) < epsilon:
        t = False
    count = count + 1


print("iterations: ")
print(count)
print(xn)